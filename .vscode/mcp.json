{
	"mcpServers": {
		"mobile-mcp": {
			"command": "npx",
			"args": [
				"-y",
				"@mobilenext/mobile-mcp@latest"
			]
		},
		"darbot-mobile": {
			"command": "npx",
			"args": [
				"-y",
				"@darbotlabs/darbot-browser-mcp@latest",
				"--device",
				"iPhone 15"
			]
		},
		"mcp-browser": {
			"command": "npx",
			"args": [
				"-y",
				"mcp-browser"
			]
		}
	}
}